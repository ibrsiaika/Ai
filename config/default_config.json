{
  "model": {
    "model_size": "base",
    "vocab_size": 50257,
    "context_length": 2048,
    "d_model": 768,
    "num_layers": 12,
    "num_heads": 12,
    "d_ff": 3072,
    "dropout": 0.1,
    "activation": "gelu",
    "initializer_range": 0.02
  },
  "training": {
    "num_epochs": 3,
    "batch_size": 32,
    "learning_rate": 5e-4,
    "weight_decay": 0.01,
    "warmup_steps": 1000,
    "max_grad_norm": 1.0,
    "gradient_accumulation_steps": 1,
    "logging_steps": 100,
    "eval_steps": 500,
    "save_steps": 1000,
    "save_total_limit": 3
  },
  "data": {
    "train_path": "wikitext",
    "val_path": null,
    "max_seq_length": 2048,
    "batch_size": 32,
    "num_workers": 4
  },
  "optimization": {
    "optimizer": "adamw",
    "fp16": true,
    "fp16_opt_level": "O2",
    "scheduler": "cosine",
    "warmup_steps": 1000
  },
  "monitoring": {
    "use_wandb": false,
    "wandb_project": "india-gpt",
    "log_dir": "./logs",
    "save_dir": "./outputs"
  },
  "generation": {
    "max_length": 128,
    "temperature": 0.7,
    "top_k": 50,
    "top_p": 0.95,
    "repetition_penalty": 1.0,
    "num_beams": 1
  }
}
