{
  "description": "Advanced configuration for complex tasks, code generation, and realistic conversations",
  
  "model": {
    "model_size": "large",
    "vocab_size": 50257,
    "context_length": 4096,
    "d_model": 1024,
    "num_layers": 24,
    "num_heads": 16,
    "d_ff": 4096,
    "dropout": 0.1,
    "activation": "gelu",
    "initializer_range": 0.02,
    "use_cache": true
  },
  
  "training": {
    "num_epochs": 10,
    "batch_size": 16,
    "learning_rate": 1e-4,
    "weight_decay": 0.01,
    "warmup_steps": 2000,
    "max_grad_norm": 1.0,
    "gradient_accumulation_steps": 4,
    "logging_steps": 50,
    "eval_steps": 500,
    "save_steps": 1000,
    "save_total_limit": 5,
    "evaluation_strategy": "steps",
    "load_best_model_at_end": true
  },
  
  "data": {
    "train_path": "wikitext",
    "val_path": null,
    "max_seq_length": 4096,
    "batch_size": 16,
    "num_workers": 8,
    "preprocessing_num_workers": 8,
    "use_language_mixing": true,
    "languages": ["en", "hi", "ta", "te", "kn", "ml"]
  },
  
  "optimization": {
    "optimizer": "adamw",
    "fp16": true,
    "fp16_opt_level": "O2",
    "scheduler": "cosine",
    "warmup_steps": 2000,
    "min_lr": 1e-6,
    "gradient_checkpointing": true
  },
  
  "monitoring": {
    "use_wandb": true,
    "wandb_project": "india-gpt-advanced",
    "wandb_entity": null,
    "log_dir": "./logs",
    "save_dir": "./outputs/advanced",
    "tensorboard": true
  },
  
  "generation": {
    "presets": {
      "code_generation": {
        "max_length": 512,
        "temperature": 0.2,
        "top_k": 40,
        "top_p": 0.9,
        "repetition_penalty": 1.1,
        "num_beams": 1,
        "do_sample": true,
        "early_stopping": false
      },
      "creative_writing": {
        "max_length": 1024,
        "temperature": 0.8,
        "top_k": 50,
        "top_p": 0.95,
        "repetition_penalty": 1.2,
        "num_beams": 1,
        "do_sample": true,
        "early_stopping": false
      },
      "conversation": {
        "max_length": 256,
        "temperature": 0.7,
        "top_k": 50,
        "top_p": 0.9,
        "repetition_penalty": 1.15,
        "num_beams": 1,
        "do_sample": true,
        "early_stopping": false
      },
      "accurate_completion": {
        "max_length": 256,
        "temperature": 0.1,
        "top_k": 10,
        "top_p": 0.8,
        "repetition_penalty": 1.0,
        "num_beams": 4,
        "do_sample": false,
        "early_stopping": true
      },
      "balanced": {
        "max_length": 512,
        "temperature": 0.5,
        "top_k": 40,
        "top_p": 0.92,
        "repetition_penalty": 1.1,
        "num_beams": 1,
        "do_sample": true,
        "early_stopping": false
      }
    },
    "default_preset": "balanced"
  },
  
  "tasks": {
    "code_generation": {
      "enabled": true,
      "languages": ["python", "javascript", "java", "c++", "go", "rust"],
      "max_context": 2048,
      "instruction_format": "### Instruction:\n{instruction}\n\n### Code:\n"
    },
    "conversation": {
      "enabled": true,
      "system_prompt": "You are a helpful, respectful and honest assistant. Always answer as helpfully as possible, while being safe.",
      "max_turns": 10,
      "format": "### Human:\n{user}\n\n### Assistant:\n"
    },
    "question_answering": {
      "enabled": true,
      "max_context": 2048,
      "format": "### Question:\n{question}\n\n### Answer:\n"
    },
    "summarization": {
      "enabled": true,
      "max_input_length": 2048,
      "max_output_length": 512
    }
  },
  
  "evaluation": {
    "metrics": ["perplexity", "bleu", "rouge", "accuracy"],
    "eval_datasets": ["wikitext", "lambada"],
    "code_eval": {
      "enabled": true,
      "benchmark": "humaneval"
    },
    "conversation_eval": {
      "enabled": true,
      "metrics": ["coherence", "relevance", "fluency"]
    }
  },
  
  "deployment": {
    "quantization": {
      "enabled": true,
      "method": "int8",
      "dynamic": true
    },
    "optimization": {
      "onnx_export": true,
      "tensorrt": false,
      "pruning": false
    },
    "api": {
      "max_batch_size": 8,
      "timeout": 30,
      "max_concurrent_requests": 100
    }
  },
  
  "competitive_features": {
    "instruction_following": true,
    "few_shot_learning": true,
    "chain_of_thought": true,
    "code_execution": false,
    "retrieval_augmentation": false,
    "multimodal": false
  }
}
